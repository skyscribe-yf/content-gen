# 图片生成 API Keys（切勿提交此文件到 git）

# yairouter — 默认图片后端（gpt-image-2），也可通过 shell 环境变量 YAI_API_KEY 注入
YAI_API_KEY=

# MiniMax Image 01 — 最便宜 $0.0035/张
MINIMAX_API_KEY=

# Nano Banana (Gemini 2.5 Flash Image) — 性价比 ~$0.02/张
NANOBANANA_API_KEY=
NANOBANANA_BASE_URL=https://reapi.ai

# SparkPix Image — 亚秒级 $0.008/张
SPARKPIX_API_KEY=
SPARKPIX_BASE_URL=https://apimodels.app
